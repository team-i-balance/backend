[Unit]
Description=iBalance FastAPI backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/backend
# Keep policy state and the SAME signing identity across checkout replacement.
# Existing installations: migrate keys before installing this unit (docs/policy-persistence.md).
StateDirectory=ibalance
StateDirectoryMode=0700
Environment=POLICY_DB_PATH=/var/lib/ibalance/policy.db
Environment=POLICY_KEYS_DIR=/var/lib/ibalance/keys
Environment=ALLOWED_ORIGINS=https://frontend-beta-plum-35.vercel.app
# No outbound connections: onnxruntime telemetry off, Hugging Face offline (local model folders only).
Environment=ORT_DISABLE_TELEMETRY=1
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
ExecStart=/home/ubuntu/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8501
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
